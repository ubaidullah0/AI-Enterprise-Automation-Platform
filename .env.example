# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=automation_platform
DATABASE_URL=postgresql://admin:password123@localhost:5432/automation_platform?schema=public

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Redis
REDIS_URL=redis://localhost:6379

# n8n
N8N_USER=admin
N8N_PASSWORD=admin
N8N_PORT=5678

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Backend Server
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Configuration
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_SELECTION=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_REQUEST_TIMEOUT=30000
