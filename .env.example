# PostgreSQL
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_database_name_here
DATABASE_URL=postgresql://your_postgres_user_here:your_postgres_password_here@localhost:5432/your_database_name_here?schema=public

# pgAdmin
PGADMIN_EMAIL=your_pgadmin_email_here
PGADMIN_PASSWORD=your_pgadmin_password_here

# Redis
REDIS_URL=redis://localhost:6379

# n8n
N8N_USER=your_n8n_user_here
N8N_PASSWORD=your_n8n_password_here
N8N_PORT=5678
N8N_API_KEY=your_n8n_api_key_here

# MinIO
MINIO_ROOT_USER=your_minio_user_here
MINIO_ROOT_PASSWORD=your_minio_password_here

# Backend Server
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_secure_refresh_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Configuration
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_SELECTION=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_REQUEST_TIMEOUT=30000
